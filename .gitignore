# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local environment variables
.venv/
venv/
env/
.env
.env.*
!.env.example

# Packaging and build output
build/
dist/
*.egg-info/

# IDE and operating-system files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Large local datasets and model weights
data/
# refactor_crop_teach/data/ also holds code (data_loader.py) next to the datasets: keep its .py files.
!refactor_crop_teach/data/
refactor_crop_teach/data/*
!refactor_crop_teach/data/*.py
checkpoints/
*.pth
*.pt
*.ckpt
*.bin
*.safetensors
*.part

# Third-party papers (reference only)
*.pdf

# Temporary artifacts (archive/results/ holds the old top-level results, tracked)
tmp/
output/
logs/
wandb/
runs/

# Notebook checkpoints
.ipynb_checkpoints/

# Third-party source code, cloned by src/download/download.py
third_party/

# MLflow store (src/common/tracking.py) and downloaded/staged asset bundles
mlruns/
.cache/
